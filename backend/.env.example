# ==============================================================================
# Store Rating Platform - Backend Environment Configuration Template
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# Frontend Client URL(s) for CORS Whitelist (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app

# PostgreSQL Database Connection (Option A: Connection String / Cloud URI)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/store_rating_db?sslmode=disable

# PostgreSQL Database Connection (Option B: Individual Parameters)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=store_rating_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# JWT Cryptographic Authentication
JWT_SECRET=replace_with_a_secure_random_32_character_string_for_production
JWT_EXPIRES_IN=7d
